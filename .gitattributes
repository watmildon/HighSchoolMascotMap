# Normalize line endings so files written on Windows and by the Ubuntu
# Actions runner don't churn against each other on every commit.
* text=auto eol=lf

# Generated by newmascots/ and rewritten by the Post Checkin Tasks workflow.
NewMascots.txt text eol=lf

# Concatenated by the workflow from the Preamble/Style/Query components.
*.ultra text eol=lf

*.cs text eol=lf
*.csproj text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.html text eol=lf

# Binary assets - never touch these.
*.png binary
